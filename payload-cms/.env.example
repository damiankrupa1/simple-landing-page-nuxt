DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payload
PAYLOAD_SECRET=
FRONTEND_URL=
# Public URL of this Payload instance. Required behind a proxy/on a host without RAILWAY_PUBLIC_DOMAIN:
# browser requests are only trusted when their Origin matches it. Defaults to https://$RAILWAY_PUBLIC_DOMAIN
# on Railway, http://localhost:3000 otherwise.
PAYLOAD_PUBLIC_SERVER_URL=
# Medusa admin SSO (the "CMS" page of the Medusa admin embeds /admin in an iframe)
MEDUSA_SSO_SECRET=
# Origins of the Medusa admin that may embed this app in an iframe and use the postMessage bridge
# (comma separated, e.g. https://admin.shop.pl,https://preview.shop.pl). MEDUSA_ADMIN_URL (one URL) still works.
MEDUSA_ADMIN_URLS=
MEDUSA_ADMIN_URL=
# true when /admin runs inside the Medusa admin iframe: inside a frame the user icon, logout icons and the
# "Log out" button are hidden and the session is refreshed in the background; opened directly, /admin behaves as
# usual. Read at runtime (restart, no rebuild). To roll back on a bad deploy set it to false and redeploy: the
# iframe itself keeps working because the origins above do not depend on it.
PAYLOAD_EMBEDDED=
# Storefront preview (drafts of the home page Globals). Both are needed for the Preview button and the Live Preview
# pane; without either the buttons disappear and nothing else changes. Read at runtime (restart, no rebuild).
# Origin of the storefront (nuxtMedusa), e.g. https://shop.example. Not FRONTEND_URL, which is the landing page.
STOREFRONT_URL=
# Shared with the storefront (its PAYLOAD_PREVIEW_SECRET): signs the short-lived link that opens preview mode.
# Generate a long random value, e.g. openssl rand -hex 32. The storefront's API key (a "Service User" created in
# the admin) is NOT a Payload variable: it lives only in the storefront's server environment.
PREVIEW_SECRET=
# Newsletter sign-ups: creating a form submission needs the header `x-newsletter-token` with this value (or a staff
# login). Only the storefront's server route knows it. Without it nobody but staff can sign up (fails closed).
# Generate a long random value, e.g. openssl rand -hex 32, and set the same value in the storefront proxy.
NEWSLETTER_SUBMIT_TOKEN=
# Newsletter discount code: every sign-up on the newsletter form (a form with an `email` and a required `consent`
# field) gets a random single-use code, returned in the create response. Percent 1-100 (default 10, 0 turns the
# feature off) and validity in days (1-365, default 30). Existing codes keep the values they were issued with.
NEWSLETTER_DISCOUNT_PERCENT=
NEWSLETTER_DISCOUNT_DAYS=
# Shared with the shop (Medusa checkout): it must send `Authorization: Bearer <this>` to
# POST /api/newsletter-discount/validate and /redeem. Without it both answer 503 (fails closed).
# Generate a long random value, e.g. openssl rand -hex 32.
NEWSLETTER_DISCOUNT_SECRET=
# Optional: shared parent domain for the auth cookie, e.g. .shop.pl
PAYLOAD_COOKIE_DOMAIN=
# Set to None when Medusa admin and Payload are on unrelated sites (e.g. two *.up.railway.app domains)
PAYLOAD_COOKIE_SAMESITE=

# Media storage on an S3-compatible bucket (Railway Bucket, AWS S3, R2, MinIO). Same names as the Medusa backend.
# Without S3_BUCKET / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY uploads stay on local disk (ephemeral on Railway).
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Required for Railway Bucket, R2 and MinIO; omit for AWS S3
S3_ENDPOINT=
# "auto" for Railway Bucket and R2 (default us-east-1)
S3_REGION=
# true only for MinIO and older Railway buckets
S3_FORCE_PATH_STYLE=
# Public base URL of the bucket. Set it to link files directly; leave empty to serve them through Payload (private bucket)
S3_FILE_URL=
# Optional folder inside the bucket, handy when sharing it with Medusa (e.g. payload)
S3_PREFIX=
