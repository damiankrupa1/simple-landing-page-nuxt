DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payload
PAYLOAD_SECRET=
FRONTEND_URL=
# Public URL of this Payload instance. Required behind a proxy/on a host without RAILWAY_PUBLIC_DOMAIN:
# browser requests are only trusted when their Origin matches it. Defaults to https://$RAILWAY_PUBLIC_DOMAIN
# on Railway, http://localhost:3000 otherwise.
PAYLOAD_PUBLIC_SERVER_URL=
# Medusa admin SSO (the "CMS" page of the Medusa admin embeds /admin in an iframe)
MEDUSA_SSO_SECRET=
MEDUSA_ADMIN_URL=
# Optional: shared parent domain for the auth cookie, e.g. .shop.pl
PAYLOAD_COOKIE_DOMAIN=
# Set to None when Medusa admin and Payload are on unrelated sites (e.g. two *.up.railway.app domains)
PAYLOAD_COOKIE_SAMESITE=

# Media storage on an S3-compatible bucket (Railway Bucket, AWS S3, R2, MinIO). Same names as the Medusa backend.
# Without S3_BUCKET / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY uploads stay on local disk (ephemeral on Railway).
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Required for Railway Bucket, R2 and MinIO; omit for AWS S3
S3_ENDPOINT=
# "auto" for Railway Bucket and R2 (default us-east-1)
S3_REGION=
# true only for MinIO and older Railway buckets
S3_FORCE_PATH_STYLE=
# Public base URL of the bucket. Set it to link files directly; leave empty to serve them through Payload (private bucket)
S3_FILE_URL=
# Optional folder inside the bucket, handy when sharing it with Medusa (e.g. payload)
S3_PREFIX=
